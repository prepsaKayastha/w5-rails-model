<h1>Products</h1>

<% if @products.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= link_to product.name, product_path(product) %></td>
          <td><%= product.price %></td>
          <td><%= product.quantity > 0 ? "In stock" : "Out of stock" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No products yet.</p>
<% end %>
